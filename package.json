{
  "name": "racing-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ai": "vitest run tests/ai.test.ts --silent=false --disableConsoleIntercept",
    "typecheck": "tsc -b",
    "build:track": "node scripts/track/build-track.mjs scripts/track/nurburgring.config.mjs && npm run derive:track",
    "derive:track": "node scripts/track/derive-from-chunks.mjs scripts/track/nurburgring.config.mjs",
    "build:car-lod": "gltf-transform simplify public/models/cars/porsche911/porsche911.glb .cache/p_low.glb --ratio 0.25 --error 0.002 && gltf-transform meshopt .cache/p_low.glb public/models/cars/porsche911/porsche911_low.glb",
    "build:garage": "node scripts/garage/build-garage.mjs",
    "capture:previews": "CAPTURE_TRACK_PREVIEWS=1 vite --host 127.0.0.1 --port 5175 --strictPort --open /preview-capture.html",
    "audit:delivery": "node scripts/performance/audit-delivery.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "test:multiplayer": "vitest run tests/multiplayer.test.ts tests/multiplayerAuth.test.ts tests/lobbyClient.test.ts",
    "build:simulation": "node scripts/multiplayer/build-simulation-assets.mjs",
    "benchmark:simulation": "npm run build:simulation && server/node_modules/.bin/tsx scripts/multiplayer/benchmark.ts",
    "test:simulation": "vitest run tests/headlessSimulation.test.ts tests/handling.test.ts",
    "server:race-dev": "npm run build:simulation && node --env-file=server/.env.local --import ./server/node_modules/tsx/dist/loader.mjs scripts/multiplayer/dev-race-server.ts",
    "test:race-reconnect": "vitest run tests/raceReconnect.test.ts tests/raceSession.test.ts tests/lobbyClient.test.ts tests/onlineRaceLifecycle.test.ts",
    "test:result-storage": "vitest run tests/practiceDatabase.test.ts tests/resultOutbox.test.ts tests/supabaseResultWriter.test.ts tests/practiceHistory.test.ts tests/raceResultsTransport.test.ts",
    "test:race-transport": "vitest run tests/raceProgress.test.ts tests/raceResults.test.ts tests/raceSession.test.ts tests/raceTransport.test.ts tests/raceResultsTransport.test.ts tests/lobbyClient.test.ts",
    "predev": "npm run build:simulation",
    "prebuild": "npm run build:simulation"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.6",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "howler": "^2.2.4",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
