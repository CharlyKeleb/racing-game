{
  "name": "racing-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:track": "node scripts/track/build-track.mjs scripts/track/nurburgring.config.mjs && npm run derive:track",
    "derive:track": "node scripts/track/derive-from-chunks.mjs scripts/track/nurburgring.config.mjs",
    "build:car-lod": "gltf-transform simplify public/models/cars/porsche911/porsche911.glb .cache/p_low.glb --ratio 0.25 --error 0.002 && gltf-transform meshopt .cache/p_low.glb public/models/cars/porsche911/porsche911_low.glb",
    "build:garage": "node scripts/garage/build-garage.mjs",
    "capture:previews": "CAPTURE_TRACK_PREVIEWS=1 vite --host 127.0.0.1 --port 5175 --strictPort --open /preview-capture.html"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "howler": "^2.2.4",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
