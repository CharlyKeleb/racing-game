# Player accounts and cloud save (docs/ACCOUNTS.md). Copy to .env.local, which git ignores.
# Both values are public (they ship in the browser bundle); row-level security protects the data.
# Never put the service_role / secret key here: anything with a VITE_ or NEXT_PUBLIC_SUPABASE_ prefix is bundled.
# Leave them empty and the game runs local-only, with no Sign in button.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Lobby backend HTTP(S) URL. Local pilot: http://localhost:2567
# Leave unset to show the preparation message and keep offline racing available.
VITE_MULTIPLAYER_URL=
