# Large binary game assets via Git LFS
*.glb filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Marina Bay's built package is stored as plain git blobs (~20 MB): the session
# that built it couldn't reach GitHub's LFS endpoint. Move it into LFS later
# with `git lfs migrate import --include="public/models/tracks/singapore/**"`.
public/models/tracks/singapore/** -filter -diff -merge binary

# In-race playlist (~22 MB of MP3s); the menu tracks predate this and stay plain blobs.
public/audio/music/race/*.mp3 filter=lfs diff=lfs merge=lfs -text
