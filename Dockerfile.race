# Build from repository root. This is separate from the existing lobby image.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server/package.json server/package-lock.json ./server/
RUN npm --prefix server ci
COPY src ./src
COPY server/src ./server/src
COPY scripts/multiplayer ./scripts/multiplayer
COPY public/models/cars ./public/models/cars
COPY public/models/tracks/nurburgring ./public/models/tracks/nurburgring
COPY vite.race.config.ts ./
COPY tsconfig.app.json tsconfig.race.json ./
RUN npm run build:race-staging
RUN npm --prefix server prune --omit=dev

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=2567 PRACTICE_ASSET_FILE=/app/simulation-assets.bin
WORKDIR /app
COPY --from=build --chown=node:node /app/server/package.json ./package.json
COPY --from=build --chown=node:node /app/server/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist-race ./dist-race
COPY --from=build --chown=node:node /app/.cache/multiplayer/simulation-assets.bin ./simulation-assets.bin
USER node
EXPOSE 2567
CMD ["node", "dist-race/server.mjs"]
